{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure (MSVC x64)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "ninja-msvc-x64"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build PalworldEditor",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "ninja-msvc-x64",
                "--target",
                "PalworldEditor"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake: deploy PalworldEditor",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "ninja-msvc-x64",
                "--target",
                "deploy"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
